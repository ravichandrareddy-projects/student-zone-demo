generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  name      String
  mobile    String   @unique
  email     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  customerMobile     String
  customerEmail      String?
  status             String      @default("NEW")
  estimatedReadyTime String?
  estimatedReadyDate String?
  actualReadyTime    DateTime?
  totalAmount        Float       @default(0.0)
  paymentStatus      String      @default("UNPAID")
  paymentMethod      String      @default("Pay at Store")
  customerNotes      String?
  adminNotes         String?
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  documentName     String
  originalFileName String
  fileUrl          String
  fileSize         Int
  fileType         String
  copies           Int      @default(1)
  colorMode        String   @default("B&W")
  paperSize        String   @default("A4")
  pageRange        String   @default("All")
  sides            String   @default("Double-sided")
  binding          String   @default("None")
  paperType        String   @default("70 GSM Standard")
  itemInstructions String?
  price            Float    @default(0.0)
  createdAt        DateTime @default(now())
}

model Service {
  id            String   @id @default(uuid())
  name          String
  category      String
  description   String
  startingPrice String?
  icon          String   @default("Printer")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PricingRate {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  category    String
  rate        Float
  unit        String
  description String?
  updatedAt   DateTime @updatedAt
}

model AdvertisingLead {
  id              String   @id @default(uuid())
  leadNumber      String   @unique
  customerName    String
  businessName    String
  phone           String
  email           String?
  service         String
  quantity        Int      @default(1)
  preferredSize   String?
  designAvailable String   @default("No")
  designFileUrl   String?
  requirements    String?
  quotedPrice     Float?
  status          String   @default("New")
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id           String   @id @default(uuid())
  customerName String
  rating       Int      @default(5)
  comment      String
  isApproved   Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  date         String?
  createdAt    DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}
